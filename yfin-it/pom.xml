<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.andreygrigoriev</groupId>
        <artifactId>yfin-parent</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>yfin-it</artifactId>
    <name>yfin integration tests</name>

    <properties>
        <!-- internal module: never deployed or published (excluded from the Central bundle in the
             parent's release profile; skipPublishing here would skip the upload for the whole build) -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <exec.mainClass>io.github.andreygrigoriev.yfin.it.FixtureRecorder</exec.mainClass>
    </properties>

    <build>
        <plugins>
            <!-- record fixtures: ./mvnw -pl yfin-it -am install -DskipTests,
                 then ./mvnw -pl yfin-it exec:java (lists cases) or exec:java -Dexec.args="chart/aapl-1d-1mo" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- live integration tests against Yahoo Finance: ./mvnw verify -Plive -->
        <profile>
            <id>live</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- with -Pnative, package also builds the NativeSmoke consumer app as target/native-smoke using
             only the plugin defaults (no yfin-specific flags); NativeSmokeIT runs it under -Plive -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-smoke</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <mainClass>io.github.andreygrigoriev.yfin.it.smoke.NativeSmoke</mainClass>
                                    <imageName>native-smoke</imageName>
                                    <!-- internal module: no SBOM (Oracle GraalVM would attach one to install/deploy) -->
                                    <skipBaseSBOM>true</skipBaseSBOM>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>io.github.andreygrigoriev</groupId>
            <artifactId>yfin-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.andreygrigoriev</groupId>
            <artifactId>yfin-live</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.andreygrigoriev</groupId>
            <artifactId>yfin-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
